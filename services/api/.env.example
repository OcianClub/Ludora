NODE_ENV=development
PORT=3000
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=use-ao-menos-32-caracteres-aleatorios
PYTHON_AI_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Separe por vírgula. Use as URLs reais do site e do renderer Electron.
# Para Electron, prefira um protocolo seguro próprio, como app://ludora,
# em vez de liberar "null" ou qualquer origem com "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Quantidade de proxies reversos confiáveis (0 local; normalmente 1 em produção).
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=256kb

# Atualiza categorias/camisas ao iniciar a API e a cada hora. false desativa.
ATUALIZACAO_TEMPORADA=true

RESEND_API_KEY=
EMAIL_FROM="Ludora <onboarding@resend.dev>"
INVITE_BASE_URL=http://localhost:3000/convites

# E-mails (separados por vírgula) com acesso ao painel Super Admin do desktop.
# Vazio = ninguém tem acesso. A verificação é feita aqui no servidor.
SUPERADMIN_EMAILS=
