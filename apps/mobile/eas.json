{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "corepack": false,
      "pnpm": "11.20.0"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "developmentClient": false,
      "autoIncrement": true,
      "node": "22.14.0",
      "corepack": false,
      "pnpm": "11.20.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ludora-pgho.onrender.com"
      }
    },
    "preview-local": {
      "extends": "preview",
      "env": {
        "LUDORA_APK_LOCAL": "1",
        "EXPO_PUBLIC_API_URL": "http://IP_DO_NOTEBOOK:3000"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "22.14.0",
      "corepack": false,
      "pnpm": "11.20.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ludora-pgho.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
