# API publicada: testes independentes do computador.
EXPO_PUBLIC_API_URL=https://ludora-pgho.onrender.com

# Emulador Android Studio, quando quiser usar a API local:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Celular físico e API local: IPv4 do computador na mesma rede.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# EXPO_PUBLIC_* fica visível no aplicativo. Nunca coloque segredos aqui.
# O ML é chamado pela API; a chave ML_API_KEY existe apenas no backend/Python.
