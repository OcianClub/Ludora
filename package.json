{
  "name": "ludora",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:api": "pnpm --filter @ludora/api run start",
    "dev:mobile": "pnpm --filter @ludora/mobile run start",
    "dev:mobile:go": "pnpm --filter @ludora/mobile run start:go",
