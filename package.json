{
  "name": "ludora",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "db:test:start": "node scripts/test-database.cjs start",
    "db:test:stop": "node scripts/test-database.cjs stop",
    "db:test:status": "node scripts/test-database.cjs status",
    "test:integracao:api": "pnpm db:test:start && pnpm --filter @ludora/api exec tsx tests/equipe.integration.ts --paulista-isolado --email-isolado --completo",
    "dev:api:teste": "pnpm db:test:start && pnpm --filter @ludora/api exec tsx tests/equipe.integration.ts --serve --paulista-isolado --email-isolado",
    "superadmin:grant": "pnpm --filter @ludora/api run superadmin:grant",
    "build:api": "pnpm --filter @ludora/api exec prisma generate && pnpm --filter @ludora/api run build",
    "start:api": "pnpm --filter @ludora/api run start",
    "build:web": "pnpm --filter @ludora/web run build",
    "dev": "node scripts/dev-stack.cjs",
    "dev:apresentacao": "node scripts/dev-stack.cjs --sem-mobile",
    "dev:web": "pnpm --filter @ludora/web run dev",
    "dev:paulista": "node scripts/dev-paulista.cjs",
    "dev:api": "node scripts/dev-service.cjs api",
    "dev:ml": "node scripts/dev-service.cjs ml",
    "dev:desktop": "pnpm --filter @ludora/desktop run dev",
    "build:desktop": "pnpm --filter @ludora/desktop run build",
    "dist:desktop": "pnpm --filter @ludora/desktop run dist:win",
    "test:desktop": "pnpm --filter @ludora/desktop run test",
    "dev:mobile": "pnpm --filter @ludora/mobile run start",
    "dev:mobile:go": "pnpm --filter @ludora/mobile run start:go",
    "dev:mobile:clean": "pnpm --filter @ludora/mobile run start:clean",
    "dev:mobile:tunnel": "pnpm --filter @ludora/mobile run start:tunnel",
    "dev:mobile:android": "pnpm --filter @ludora/mobile run android",
    "dev:mobile:check": "pnpm --filter @ludora/mobile run check",
    "perf:scout": "pnpm --filter @ludora/api exec tsx ../../apps/mobile/tests/scout.bench.ts",
    "test:app": "pnpm --filter @ludora/api exec tsx --require ./tests/setup.cjs --test tests/*.test.ts ../../apps/mobile/tests/*.test.ts",
    "test:app:completo": "pnpm --filter @ludora/api run build && pnpm --filter @ludora/api exec tsx --require ./tests/setup.cjs --test tests/*.test.ts tests/*.test.cjs tests/*.test.mjs ../../apps/mobile/tests/*.test.ts ../../apps/web/tests/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
